# Copie para .env e ajuste. Gere um segredo forte: openssl rand -hex 32
JWT_SECRET=
DB_PASSWORD=pontomax
PUBLIC_URL=http://localhost:8080
PORT=8080
# true para criar a empresa de demonstração (admin@pontomax.app / pontomax123)
SEED_DEMO=false
# Número de registro do REP-P no INPI e CNPJ do desenvolvedor (cabeçalho do AFD)
REP_INPI_NUMBER=
REP_DEVELOPER_CNPJ=
# E-mail (convites e recuperação de senha)
# Certificado A1 ICP-Brasil (.pfx) para assinar AFD, AEJ e comprovantes.
# Sem ele, um certificado autoassinado é gerado em STORAGE_DIR/signing (só para testes).
SIGNING_CERT_PATH=
SIGNING_CERT_PASSWORD=
# Alternativa ao arquivo: conteúdo do .pfx em base64 (ex.: Secret Manager)
SIGNING_CERT_BASE64=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PontoMax <nao-responda@pontomax.app>
